# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Settings use the prefix RAG_ and a "__" nested delimiter (see src/enterprise_rag/config/settings.py).

# --- Azure OpenAI ---
RAG_AZURE_OPENAI__ENDPOINT=https://your-resource.openai.azure.com/
RAG_AZURE_OPENAI__API_KEY=your-azure-openai-key
RAG_AZURE_OPENAI__API_VERSION=2024-10-21
RAG_AZURE_OPENAI__CHAT_DEPLOYMENT=gpt-4o-mini
RAG_AZURE_OPENAI__EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Azure AI Search ---
RAG_AZURE_SEARCH__ENDPOINT=https://your-search.search.windows.net
RAG_AZURE_SEARCH__API_KEY=your-azure-search-admin-key
RAG_AZURE_SEARCH__INDEX_NAME=research-papers
RAG_AZURE_SEARCH__EMBEDDING_DIMENSIONS=1536

# --- Chunking (optional, defaults shown) ---
RAG_CHUNKING__CHUNK_SIZE=1000
RAG_CHUNKING__CHUNK_OVERLAP=200

# --- Retrieval (optional, defaults shown) ---
RAG_RETRIEVAL__TOP_K=5
